# Runtime
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
FRONTEND_ORIGIN=http://localhost:3001

# PostgreSQL (used once the database layer is introduced)
DATABASE_URL=postgresql://postgres:123456@localhost:5432/teamflow

# Authentication
JWT_ACCESS_SECRET=replace-this-development-secret-with-at-least-32-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_TOKEN_CLEANUP_INTERVAL_HOURS=24

# Abuse protection
AUTH_RATE_LIMIT_MAX_REQUESTS=5
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
