# Runtime
NODE_ENV=test
PORT=3000
LOG_LEVEL=info

# PostgreSQL (used once the database layer is introduced)
DATABASE_URL=postgresql://postgres:123456@localhost:5432/teamflow_test

# Authentication
JWT_ACCESS_SECRET=test-secret-that-is-at-least-32-characters-long
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
